{
  "name": "system-styles",
  "version": "0.0.0-development",
  "description": "A CSS library that provides reasonable defaults for system's native HTML elements without requiring classes",
  "main": "system.css",
  "types": "system.d.ts",
  "style": "system.css",
  "unpkg": "system.css",
  "jsdelivr": "system.css",
  "exports": {
    ".": {
      "types": "./system.d.ts",
      "style": "./system.css",
      "default": "./system.css"
    },
    "./system.css": "./system.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "system.css",
    "system.d.ts"
  ],
  "scripts": {
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "css",
    "styles",
    "framework",
    "native",
    "html",
    "classless",
    "semantic",
    "responsive",
    "system"
  ],
  "author": "Rafal Enden",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafalenden/system-design.git"
  },
  "bugs": {
    "url": "https://github.com/rafalenden/system-design/issues"
  },
  "homepage": "https://github.com/rafalenden/system-design#readme",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^24.2.9"
  }
}
